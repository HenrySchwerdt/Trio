    "The pump battery is low. Replace the battery soon.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Pumpenbatterie ist schwach. Wechsle die Batterie bald."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pump battery is low. Replace the battery soon."
          }
        }
      }
    },
    "The pump data is more than 15 minutes old. Insulin is not delivered until the pump has been read again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Pumpendaten sind älter als 15 Minuten. Es wird kein Insulin abgegeben, bis die Pumpe erneut gelesen wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
