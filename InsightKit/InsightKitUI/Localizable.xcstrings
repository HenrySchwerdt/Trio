    "Trio could not confirm the last command (%@). No further insulin is given until this is resolved.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trio konnte den letzten Befehl (%@) nicht bestätigen. Bis dies geklärt ist, wird kein weiteres Insulin abgegeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trio could not confirm the last command (%@). No further insulin is given until this is resolved."
          }
        }
      }
    },
    "Trio could not read an entry of the pump history. Insulin that may have been delivered is counted. Check the pump history and update the InsightBridge app.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trio konnte einen Eintrag des Pumpenverlaufs nicht lesen. Möglicherweise abgegebenes Insulin wird mitgezählt. Prüfe den Pumpenverlauf und aktualisiere die InsightBridge-App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trio could not read an entry of the pump history. Insulin that may have been delivered is counted. Check the pump history and update the InsightBridge app."
          }
        }
      }
    },
    "Trio has not been able to talk to the InsightBridge app for a while. Check that the Android phone is on, the app is running and Bluetooth is enabled.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trio konnte seit einiger Zeit nicht mit der InsightBridge-App kommunizieren. Prüfe, ob das Android-Handy eingeschaltet, die App geöffnet und Bluetooth aktiv ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trio has not been able to talk to the InsightBridge app for a while. Check that the Android phone is on, the app is running and Bluetooth is enabled."
          }
        }
      }
    },
    "Trio keeps counting a possibly delivered bolus as insulin on board, and gives no further insulin until this is resolved.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
