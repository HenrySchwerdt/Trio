    "The Insight pump cannot talk to an iPhone directly. Trio controls it through a small Android helper app called InsightBridge that stays connected to the pump.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Insight-Pumpe kann nicht direkt mit einem iPhone kommunizieren. Trio steuert sie über eine kleine Android-Hilfs-App namens InsightBridge, die mit der Pumpe verbunden bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Insight pump cannot talk to an iPhone directly. Trio controls it through a small Android helper app called InsightBridge that stays connected to the pump."
          }
        }
      }
    },
    "The Insight supports at most 24 basal entries (got %d).": {
      "extractionState": "manual",
